# Copy to .env; start.sh loads it. Everything is optional.
# PCI_HOST=127.0.0.1
# PCI_PORT=8787
# PCI_BACKEND=comfyui            # or "mock" to test without ComfyUI
# PCI_COMFYUI_URL=http://127.0.0.1:8188   # unset = try :8188 then :8000 (ComfyUI Desktop)
# PCI_OUTPUT_DIR=~/Movies/PCI-Academy     # default on macOS
# PCI_WORKFLOW_DIR=./workflows
# PCI_JOB_TIMEOUT=10800          # seconds
# Pin exact model files (names as ComfyUI lists them) instead of auto-detection:
# PCI_LTX_CHECKPOINT=ltxv-2b-0.9.8-distilled.safetensors
# PCI_LTX_TEXT_ENCODER=t5xxl_fp16.safetensors
