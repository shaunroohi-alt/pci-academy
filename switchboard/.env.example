# ─────────────────────────────────────────────────────────────────────────────
# Switchboard configuration. Copy to .env and fill in what you use:
#   cp .env.example .env
# Every key is read on the server only. Never prefix secrets with NEXT_PUBLIC_.
# A provider without credentials simply shows up as "not configured".
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic Claude ─────────────────────────────── https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: comma-separated model ids to show instead of the live /v1/models list.
# ANTHROPIC_MODELS=claude-opus-5,claude-fable-5-1,claude-opus-5-5,claude-sonnet-5,claude-haiku-4-5
# ANTHROPIC_DEFAULT_MODEL=claude-opus-5
# Optional gateway/proxy. Leave unset to talk to api.anthropic.com.
# ANTHROPIC_BASE_URL=
# Server-side refusal fallbacks for claude-opus-5 / claude-fable-5-1 (on by default).
# ANTHROPIC_REFUSAL_FALLBACK=true

# ── OpenAI ───────────────────────────────────────── https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_MODELS=gpt-5,gpt-5-mini,gpt-4.1
# OPENAI_DEFAULT_MODEL=gpt-5
# OPENAI_BASE_URL=

# ── Google Gemini ────────────────────────────────── https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-pro,gemini-2.5-flash
# GEMINI_DEFAULT_MODEL=gemini-2.5-pro
# GEMINI_BASE_URL=

# ── Astra: any OpenAI-compatible endpoint ────────────────────────────────────────
# "Astra" is a configurable slot, not a specific vendor. Point it at anything that
# implements the OpenAI Chat Completions API: Ollama, LM Studio, vLLM, llama.cpp
# server, LiteLLM, OpenRouter, Together, Groq, Mistral, DeepSeek, your own gateway…
#   Ollama:     ASTRA_BASE_URL=http://localhost:11434/v1
#   LM Studio:  ASTRA_BASE_URL=http://localhost:1234/v1
#   (inside Docker use http://host.docker.internal:11434/v1)
ASTRA_BASE_URL=
ASTRA_API_KEY=
ASTRA_LABEL=Astra
# If the endpoint has no /models listing, list model ids here.
# ASTRA_MODELS=llama3.1,qwen2.5-coder
# ASTRA_DEFAULT_MODEL=llama3.1
# Extra headers as JSON, e.g. {"HTTP-Referer":"http://localhost"}
# ASTRA_HEADERS=
# Capabilities of the endpoint (many local servers support neither by default).
ASTRA_SUPPORTS_IMAGES=false
ASTRA_SUPPORTS_TOOLS=false

# ── App ──────────────────────────────────────────────────────────────────────────
# APP_NAME=Switchboard
# DEFAULT_PROVIDER=anthropic
# DEFAULT_MODEL=claude-opus-5
# Offline echo provider for demos/tests (no network, no key).
ENABLE_MOCK_PROVIDER=false

# Protect the UI + API with HTTP Basic auth. SET THIS if anyone but you can reach
# the server — otherwise they can spend your provider credits.
# APP_USERNAME=admin
# APP_PASSWORD=

# Requests per minute per client IP to /api/chat and the workspace (0 = unlimited).
RATE_LIMIT_PER_MINUTE=30
MAX_ATTACHMENT_MB=10

# ── Storage ──────────────────────────────────────────────────────────────────────
DATA_DIR=./data
WORKSPACE_DIR=./workspace

# ── Code workspace ───────────────────────────────────────────────────────────────
# Lets the agent and the terminal run shell commands inside WORKSPACE_DIR.
# Commands run with the server's OS permissions: enable only on a machine you trust.
ENABLE_SHELL=false
SHELL_TIMEOUT_MS=60000
MAX_AGENT_STEPS=25

# Bridge to the official Claude Code CLI (https://docs.claude.com/en/docs/claude-code).
# Requires `claude` installed and signed in (or ANTHROPIC_API_KEY set).
ENABLE_CLAUDE_CODE_CLI=false
# CLAUDE_CODE_BIN=claude
# Extra CLI flags. The default lets it edit files; shell use still needs approval
# (which headless mode can't give), so Bash calls are declined.
# CLAUDE_CODE_ARGS=--permission-mode acceptEdits
