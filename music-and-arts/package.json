{
  "name": "music-and-arts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website for the piano technician, piano trade-in and music tutoring business (working name: Music and Arts).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-strip-types --no-warnings scripts/migrate.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3"
  }
}
