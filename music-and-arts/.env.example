# Postgres connection string (Railway injects this from the Postgres service).
DATABASE_URL=postgresql://maa:maa@127.0.0.1:5432/maa
# Password for the /admin area. Required in production.
ADMIN_PASSWORD=change-me
# Optional: secret used to sign the admin session cookie. Defaults to a hash of ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
# Public site settings (the business name is a working name and will change).
NEXT_PUBLIC_SITE_NAME="Music and Arts"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
