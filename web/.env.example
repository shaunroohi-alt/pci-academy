# ── Public (bundled into the static site) ────────────────────────────────
# Site URL used for metadata. Optional.
NEXT_PUBLIC_APP_URL=
# Leave both Supabase values empty to run in local-first mode: all material
# stays in the browser's IndexedDB on this device and no account exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only (Supabase Edge Function secrets — never NEXT_PUBLIC_) ─────
# Set with: supabase secrets set AI_PROVIDER=anthropic AI_API_KEY=... AI_MODEL=...
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AUDIO_PROVIDER=
AUDIO_API_KEY=
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
