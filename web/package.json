{
  "name": "pci-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PCI Web App \u2014 observational intelligence environment for PCI Academy.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-sw.mjs",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/db-seed.mts",
    "edge:sync": "node scripts/sync-edge-shared.mjs",
    "edge:check": "node scripts/sync-edge-shared.mjs --check",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm edge:check && pnpm build",
    "edge:test": "cd supabase/functions && deno test --config pci-analyze/deno.json --allow-env _shared/analyze.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "2.117.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "8.0.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
