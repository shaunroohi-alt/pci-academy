// Cloudflare Workers Builds deploys the PCI Academy web app (app/) as static assets.
// The Worker name must match the Worker connected in the Cloudflare dashboard.
{
  "name": "pci-academy",
  "compatibility_date": "2025-09-01",
  "build": {
    "command": "npm ci --prefix app --no-audit --no-fund && npm run build --prefix app"
  },
  "assets": {
    "directory": "./app/dist",
    "not_found_handling": "single-page-application"
  }
}
